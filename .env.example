# Security Settings
# Generate using: openssl rand -hex 32
APP_SECRET_SALT=
SHOPIFY_API_SECRET=
POSTGRES_PASSWORD= # generate: openssl rand -base64 32
ENVIRONMENT=development
CORS_ORIGINS=https://app.yourdomain.com
DEPLOYMENT_TYPE=local

# Database Settings
DATABASE_TYPE=sqlite
SQLITE_PATH=./data/tenants
POSTGRES_URL=sqlite:///data/central.db

# Background Tasks
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Server Settings
APP_HOST=0.0.0.0
APP_PORT=8001
WORKERS_COUNT=4
SUPPORT_EMAIL=support@trueroas.com

# Business Logic
DAILY_SPEND_CAP=500.0
VARIABLE_COST_RATE=0.40
MIN_SAMPLE_SIZE_FOR_CONFIDENCE=30
BREAKER_THRESHOLD_MULTIPLIER=2.0
EXPORT_DAYS_LOOKBACK=7

# Bayesian Calibration
BAYESIAN_PRIOR_VARIANCE_METHOD=empirical
BAYESIAN_DEFAULT_PRIOR_VAR=1.0

# Decision Thresholds
STRONG_SCALE_PROB_THRESHOLD=0.75
STRONG_SCALE_EV_THRESHOLD_PCT=0.50
CAUTIOUS_SCALE_PROB_THRESHOLD=0.55
RISK_WEIGHT_BASE=0.7
RISK_WEIGHT_VOL_MULTIPLIER=0.8
RISK_WEIGHT_CAP=1.2
MARGINAL_DECAY_RATE=0.15

# Benchmark Defaults
DEFAULT_BENCHMARK_CTR=0.015
DEFAULT_BENCHMARK_CR=0.025
DEFAULT_BENCHMARK_FREQ=2.5

# Integration Settings
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
CORE_PLAN_PRICE_ID=price_...
ACCOUNTABILITY_PLAN_PRICE_ID=price_...

RESEND_API_KEY=re_...
DEFAULT_FROM_EMAIL=audit@trueroas.com

META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=
META_PIXEL_ID=
META_API_VERSION=v21.0
SHOPIFY_STORE=
SHOPIFY_TOKEN=
TELEGRAM_BOT_TOKEN=DEMO
TELEGRAM_CHAT_ID=
TRUEROAS_API_URL=http://localhost:8001/api/v1/status
ECB_API_KEY=  # for FX rates

# API Limits
RATE_LIMIT_SYNC=10/minute
RATE_LIMIT_METRICS=30/minute